{
  "systemSetup": [],
  "templateName": "custom",
  "projectDependencies": [
    {
      "name": "Install Dependencies",
      "command": "npm install"
    }
  ],
  "codeChecks": [
    {
      "name": "Lint",
      "command": "npm run lint"
    }
  ],
  "buildSteps": [
    {
      "name": "Build Project",
      "command": "npm run build"
    }
  ],
  "runStep": [
    {
      "name": "Run Dev Server",
      "command": "npm run dev -- --host --port 4000",
      "port": "4000"
    }
  ],
  "deploySteps": [
    {
      "name": "Vercel Deploy",
      "command": "npx vercel deploy --prod"
    }
  ],
  "cleanupFiles": [
    "node_modules",
    "dist",
    ".vercel",
    ".output",
    ".nitro",
    ".tanstack"
  ],
  "packageManager": "npm",
  "envPaths": [
    {
      "name": "default",
      "path": ".env"
    }
  ]
}
