VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional — local setup script only (scripts/setup-storage.mjs). Never commit. Never use VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Local demos only — seeds 10 sample students when DB is empty (off in production)
# VITE_ENABLE_DEMO_SEED=true

# Admin AI Assistant — server-only (never use VITE_ prefix). Restart dev server after changes.

# 1) Groq — https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# 2–3) OpenRouter — https://openrouter.ai/keys (one key for both models below)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL_OPENAI=openai/gpt-oss-20b:free
# OPENROUTER_MODEL_NVIDIA=nvidia/nemotron-3.5-lightning:free

# Optional — shown to OpenRouter for analytics
# APP_URL=http://localhost:3000
