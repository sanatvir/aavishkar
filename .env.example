VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Required on Vercel/production — the app uses live Supabase data only (no mock runtime).

# Optional — server-side roster lookup (recommended). Never commit. Never use VITE_ prefix.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Local demos only — seeds 10 sample students when DB is empty (off in production)
# VITE_ENABLE_DEMO_SEED=true

# ---------- Microsoft student sign-in (server-only — no VITE_ prefix) ----------
# 1) Azure Portal → App registrations → New → Web redirect URI:
#    http://localhost:3000/api/auth/microsoft/callback
#    https://YOUR-VERCEL-DOMAIN/api/auth/microsoft/callback
# 2) Copy Application (client) ID, create a client secret, copy Directory (tenant) ID
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_TENANT_ID=
# AUTH_SECRET=generate-a-long-random-string
# APP_URL=https://your-vercel-domain.vercel.app

# Admin AI Assistant — server-only (never use VITE_ prefix). Restart dev server after changes.

# 1) Groq — https://console.groq.com/keys
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.1-8b-instant

# 2–3) OpenRouter — https://openrouter.ai/keys (one key for both models below)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL_OPENAI=openai/gpt-oss-20b:free
# OPENROUTER_MODEL_NVIDIA=nvidia/nemotron-3.5-lightning:free

# Optional — shown to OpenRouter for analytics; also used as Microsoft OAuth redirect base
# APP_URL=http://localhost:3000
